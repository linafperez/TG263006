process {

    // ========================================================
    // TEST PROFILE
    // ========================================================
    //
    // Lightweight resources for local pipeline validation.
    // Scientific parameters and input data are supplied
    // through a dedicated -params-file.
    // ========================================================

    executor = 'local'

    withLabel: process_single {
        cpus   = 1
        memory = 2.GB
        time   = 2.h
    }

    withLabel: process_low {
        cpus   = 2
        memory = 4.GB
        time   = 4.h
    }

    withLabel: process_medium {
        cpus   = 4
        memory = 8.GB
        time   = 6.h
    }

    withLabel: process_high {
        cpus   = 4
        memory = 16.GB
        time   = 12.h
    }

    withLabel: qiime {
        cpus   = 4
        memory = 8.GB
        time   = 12.h
    }
}
