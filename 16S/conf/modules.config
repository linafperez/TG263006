process {


    // ========================================================
    // DEFAULT PUBLISHING
    // ========================================================

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        enabled: false
    ]


    // ========================================================
    // PREPROCESSING
    // ========================================================

    withName: 'SAMPLESHEET_CHECK' {

        publishDir = [
            path: { "${params.outdir}/Preprocessing/samplesheet" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'MERGE_LANES' {

        publishDir = [
            path: { "${params.outdir}/Preprocessing/merged_fastq" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'METADATA_CHECK' {

        publishDir = [
            path: { "${params.outdir}/Preprocessing/metadata" },
            mode: params.publish_dir_mode
        ]
    }


    // ========================================================
    // QC
    // ========================================================

    withName: 'FASTQC' {

        publishDir = [
            path: { "${params.outdir}/QC/fastqc" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'DEMUX_SUMMARIZE' {

        publishDir = [
            path: { "${params.outdir}/QC/demux" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'CUTADAPT_SUMMARIZE' {

        publishDir = [
            path: { "${params.outdir}/QC/cutadapt" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'DENOISING_SUMMARY' {

        publishDir = [
            path: { "${params.outdir}/QC/dada2" },
            mode: params.publish_dir_mode
        ]
    }


    // ========================================================
    // QIIME
    // ========================================================

    withName: 'IMPORT' {

        publishDir = [
            path: { "${params.outdir}/Qiime/import" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'CUTADAPT_TRIM' {

        publishDir = [
            path: { "${params.outdir}/Qiime/cutadapt" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'DADA2' {

        publishDir = [
            path: { "${params.outdir}/Qiime/dada2" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'SILVA_DOWNLOAD' {

        publishDir = [
            path: { "${params.outdir}/Qiime/silva/download" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'SILVA_CURATION' {

        publishDir = [
            path: { "${params.outdir}/Qiime/silva/curation" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'SILVA_EXTRACTION' {

        publishDir = [
            path: { "${params.outdir}/Qiime/silva/extraction" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'TRAIN_CLASSIFIER' {

        publishDir = [
            path: { "${params.outdir}/Qiime/classifier" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'TAXONOMIC_CLASSIFICATION' {

        publishDir = [
            path: { "${params.outdir}/Qiime/taxonomy" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'TAXONOMIC_FILTERING' {

        publishDir = [
            path: { "${params.outdir}/Qiime/taxonomic_filtering" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'QIIME_EXPORT_R' {

        publishDir = [
            path: { "${params.outdir}/Qiime/export" },
            mode: params.publish_dir_mode
        ]
    }


    // ========================================================
    // ABUNDANCE
    // ========================================================

    withName: 'ABUNDANCE_PREPROCESSING_R' {

        publishDir = [
            path: { "${params.outdir}/Abundance" },
            mode: params.publish_dir_mode
        ]
    }


    // ========================================================
    // TAXONOMIC COMPOSITION
    // ========================================================

    withName: 'TAXONOMIC_COMPOSITION' {

        publishDir = [
            path: { "${params.outdir}/Taxonomy_composition" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'TAXONOMIC_COMPOSITION_GROUPED' {

        publishDir = [
            path: { "${params.outdir}/Taxonomy_composition" },
            mode: params.publish_dir_mode
        ]
    }


    // ========================================================
    // ALPHA DIVERSITY
    // ========================================================

    withName: 'ALPHA_DIVERSITY' {

        publishDir = [
            path: { "${params.outdir}/Alpha_diversity" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'ALPHA_DIVERSITY_PROCESS' {

        publishDir = [
            path: { "${params.outdir}/Alpha_diversity" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'ALPHA_DIVERSITY_PLOT' {

        publishDir = [
            path: { "${params.outdir}/Alpha_diversity" },
            mode: params.publish_dir_mode
        ]
    }


    // ========================================================
    // BETA DIVERSITY
    // ========================================================

    withName: 'BETA_DIVERSITY' {

        publishDir = [
            path: { "${params.outdir}/Beta_diversity" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'BETA_DIVERSITY_PROCESS' {

        publishDir = [
            path: { "${params.outdir}/Beta_diversity" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'BETA_DIVERSITY_PLOT' {

        publishDir = [
            path: { "${params.outdir}/Beta_diversity" },
            mode: params.publish_dir_mode
        ]
    }


    withName: 'PERMANOVA' {

        publishDir = [
            path: { "${params.outdir}/Beta_diversity/permanova" },
            mode: params.publish_dir_mode
        ]
    }

    // ========================================================
    // MULTIQC
    // ========================================================

    withName: 'MULTIQC' {

        publishDir = [
            path: { "${params.outdir}/QC/MultiQC" },
            mode: params.publish_dir_mode,
            pattern: "**"
        ]
    }

}
