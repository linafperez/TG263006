nextflow.enable.dsl = 2


// ============================================================
// GENERAL PARAMETERS
// ============================================================

params {

    // --------------------------------------------------------
    // 1. ORCHESTRATION & I/O
    // --------------------------------------------------------

    input             = null
    outdir            = null
    publish_dir_mode  = 'copy'
    validate_params   = true


    // --------------------------------------------------------
    // 2. SILVA REFERENCE DATABASE
    // --------------------------------------------------------

    silva_version                = '138.2'
    silva_target                 = 'SSURef_NR99'
    silva_include_species_labels = true

    // Optional local SILVA QIIME2 artifacts.
    // If both are provided, automatic download is skipped.
    silva_sequences              = null
    silva_taxonomy               = null

    silva_derep_mode             = 'uniq'

    silva_min_length             = 200
    silva_max_length             = 350
    silva_extract_identity       = 0.8


    // --------------------------------------------------------
    // 3. PRIMERS
    // --------------------------------------------------------

    primers = null


    // --------------------------------------------------------
    // 4. DADA2
    // --------------------------------------------------------

    trunc_len_f = null
    trunc_len_r = null

    trim_left_f = 0
    trim_left_r = 0

    max_ee_f = 2.0
    max_ee_r = 2.0

    trunc_q     = 2
    min_overlap = 12

    pooling_method = 'independent'
    chimera_method = 'consensus'

    n_reads_learn = 1000000

    hashed_feature_ids = true
    retain_all_samples = true


    // --------------------------------------------------------
    // 5. TAXONOMIC CLASSIFICATION
    // --------------------------------------------------------

    taxonomy_read_orientation = null
    taxonomy_confidence       = null


    // --------------------------------------------------------
    // 6. TAXONOMIC FILTERING
    // --------------------------------------------------------

    taxonomy_exclude = null


    // --------------------------------------------------------
    // 7. SAMPLE METADATA
    // --------------------------------------------------------

    metadata = null


    // --------------------------------------------------------
    // 8. ABUNDANCE PREPROCESSING
    // --------------------------------------------------------

    prevalence_threshold = null


    // --------------------------------------------------------
    // 9. ALPHA DIVERSITY
    // --------------------------------------------------------

    alpha_group_column = null


    // --------------------------------------------------------
    // 10. TAXONOMIC COMPOSITION
    // --------------------------------------------------------

    composition_taxonomic_rank = null
    composition_rare_threshold = null
    composition_group_column   = null


    // --------------------------------------------------------
    // 11. BETA DIVERSITY
    // --------------------------------------------------------

    beta_zero_method    = null
    beta_zero_fraction  = null
    beta_zero_threshold = null
    
    beta_min_positive_samples = 2
    
    beta_group_column = null

    permanova_column       = null
    permanova_permutations = null


    // --------------------------------------------------------
    // 12. PIPELINE LOGISTICS
    // --------------------------------------------------------

    email           = null
    email_on_fail   = null
    plaintext_email = false
    monochrome_logs = false

    help        = false
    help_full   = false
    show_hidden = false
    version     = false

    trace_report_suffix = new java.util.Date().format(
        'yyyy-MM-dd_HH-mm-ss'
    )
}


// ============================================================
// CONFIGURATION IMPORTS
// ============================================================

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'


// ============================================================
// EXECUTION STRATEGY
// ============================================================

process {

    /*
     * Default execution on Hypatia.
     *
     * Runtime/container technology is selected independently
     * using -profile singularity, apptainer, or docker.
     */

    executor = 'slurm'
    queue    = 'short'


    /*
     * Taxonomic classifier training.
     *
     * This is the most memory-intensive QIIME2 step and is sent
     * to Hypatia big-memory nodes.
     */

    withName: 'TRAIN_CLASSIFIER' {

        queue = 'bigmem'

        cpus = 4

        memory = {
            64.GB * task.attempt
        }

        time = {
            12.h * task.attempt
        }

        maxRetries = 1

        errorStrategy = {
            task.exitStatus in [137, 143]
                ? 'retry'
                : 'finish'
        }
    }
}


// ============================================================
// PROFILES
// ============================================================

profiles {

    // --------------------------------------------------------
    // DEBUG
    // --------------------------------------------------------

    debug {

        dumpHashes = true
        process.beforeScript = 'echo $HOSTNAME'
        cleanup = false

        nextflow.enable.configProcessNamesValidation = true
    }


    // --------------------------------------------------------
    // CONDA
    // --------------------------------------------------------

    conda {

        conda.enabled  = true
        conda.channels = [
            'conda-forge',
            'bioconda'
        ]
    }


    // --------------------------------------------------------
    // MAMBA
    // --------------------------------------------------------

    mamba {

        conda.enabled  = true
        conda.useMamba = true
    }


    // --------------------------------------------------------
    // DOCKER
    // --------------------------------------------------------

    docker {

        docker.enabled = true

        docker.runOptions =
            '-u $(id -u):$(id -g)'
    }


    // --------------------------------------------------------
    // SINGULARITY
    // --------------------------------------------------------

    singularity {

        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.pullTimeout = '1h'

        singularity.cacheDir =
            "${projectDir}/work/singularity"
    }


    // --------------------------------------------------------
    // APPTAINER
    // --------------------------------------------------------

    apptainer {

        apptainer.enabled    = true
        apptainer.autoMounts = true
    }


    // --------------------------------------------------------
    // TEST
    // --------------------------------------------------------

    test {

        includeConfig 'conf/test.config'
    }
}


// ============================================================
// CONDA
// ============================================================

conda {

    /*
     * Local pipeline-specific modules use Conda environments.
     */

    enabled = true

    cacheDir =
        "${System.getenv('HOME')}/.nextflow/conda"
}


// ============================================================
// CONTAINER REGISTRIES
// ============================================================

docker.registry      = 'quay.io'
singularity.registry = 'quay.io'
apptainer.registry   = 'quay.io'


// ============================================================
// ENVIRONMENT
// ============================================================

env {

    PYTHONNOUSERSITE = 1

    /*
     * Writable Numba cache required by QIIME2 processes.
     */

    NUMBA_CACHE_DIR = '/tmp/numba_cache'
}


// ============================================================
// SHELL
// ============================================================

process.shell = [
    'bash',
    '-C',
    '-e',
    '-u',
    '-o',
    'pipefail'
]


// ============================================================
// PROCESS NAME VALIDATION
// ============================================================

nextflow.enable.configProcessNamesValidation = false


// ============================================================
// TRACEABILITY
// ============================================================

timeline {

    enabled = true

    file =
        "${params.outdir}/QC/Pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}


report {

    enabled = true

    file =
        "${params.outdir}/QC/Pipeline_info/execution_report_${params.trace_report_suffix}.html"
}


trace {

    enabled = true

    file =
        "${params.outdir}/QC/Pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}


dag {

    enabled = true

    file =
        "${params.outdir}/QC/Pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}


// ============================================================
// MANIFEST
// ============================================================

manifest {

    name =
        '16S_rRNA_analysis'

    description =
        'Reproducible 16S rRNA amplicon analysis pipeline using QIIME2 and R.'

    mainScript =
        'main.nf'

    nextflowVersion =
        '!>=22.10.1'

    version =
        '1.0.0'
}
