/*
 * Singularity configuration for HPC
 *
 * Use this profile when running on the cluster with SLURM.
 */

singularity {
    enabled = true
    autoMounts = true
    cacheDir = "${projectDir}/.singularity"
}

docker {
    enabled = false
}

/*
 * Allow processes without a container to use their Conda environment.
 * Processes defining both container and conda continue using the container.
 */
conda {
    enabled = true
    createTimeout = "180 min"
}

/*
 * Containerized processes do not need Conda environments.
 * Keep Conda enabled globally for local processes without a container.
 */
process {
    withName: 'FASTQC_RAW|FASTQC_CLEAN|FASTP|SORTMERNA|STAR|SPADES_RNA|QUAST|TRANSDECODER|DIAMOND|SALMON_INDEX|SALMON_QUANT|MULTIQC|PREPARE_MAG_PROTEIN_DATABASE' {
        conda = null
    }
}
