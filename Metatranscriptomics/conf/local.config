/*
 * Local resource configuratio
 */

process {

    executor = 'local'

    withLabel: process_low {
        cpus = 1
        memory = '1 GB'
    }

    withLabel: process_medium {
        cpus = 1
        memory = '2 GB'
    }

    withLabel: process_high {
        cpus = 1
        memory = '2 GB'
    }

    withLabel: process_very_high {
        cpus = 1
        memory = '3 GB'
    }
}
