/*
 * Reference files and biological databases
 */

params {

    /*
     * rRNA database for SortMeRNA
     */
    rrna_db_dir = "data/references/rrna_database_release_v4"

    /*
     * Human reference STAR index
     */
    star_index = "data/references/human_GRCh38_p14_GENCODE_v44/STAR_IDX"

    /*
     * MAG protein database inputs
     */
    mag_protein_dir = "data/mag_annotations/proteins"
}