/*
 * Base configuration
 */

params {

    /*
     * Input / output
     */
    input  = "data/samplesheet_95samples.csv"
    outdir = "results/95_samples"

    /*
     * Differential expression
     */
    condition_column       = "condition"
    case_label             = "PD"
    control_label          = "HC"
    expression_outdir_name = "PD_vs_HC"
    expression_report_name = "PD_vs_HC"

    /*
     * FastQC
     */
    fastqc_args = ""

    /*
     * fastp
     */
    fastp_args = "--qualified_quality_phred 30 --length_required 30 --detect_adapter_for_pe --trim_poly_g --trim_poly_x --cut_right --cut_right_window_size 4 --cut_right_mean_quality 30"

    /*
     * SortMeRNA
     */
    sortmerna_args = "--paired_in --fastx --out2"

    /*
     * STAR
     */
    star_args = "--twopassMode Basic --sjdbScore 1 --outFilterType BySJout --outFilterMultimapNmax 20 --outFilterMismatchNmax 999 --outFilterMismatchNoverReadLmax 0.04 --alignSJoverhangMin 8 --alignSJDBoverhangMin 1 --alignIntronMin 20 --alignIntronMax 1000000 --alignMatesGapMax 1000000"

    /*
     * rnaSPAdes
     */
    spades_rna_args = "--rna"

    /*
     * rnaQUAST
     */
    quast_args = ""

    /*
     * TransDecoder
     */
    transdecoder_longorfs_args = "-m 30"
    transdecoder_predict_args  = "--single_best_only"

    /*
     * DIAMOND
     */
    diamond_args = "--evalue 1e-10 --id 95 --query-cover 90 --subject-cover 90 --max-target-seqs 25 --very-sensitive --masking 1 --block-size 10.0 --index-chunks 1"

    /*
     * Salmon
     */
    salmon_index_args = "-k 31"
    salmon_quant_args = "-l A --meta --validateMappings --recoverOrphans --rangeFactorizationBins 4 --seqBias --gcBias --posBias --discardOrphansQuasi --minScoreFraction 0.8 --consensusSlack 0.05 --numBootstraps 50"

    /*
     * MultiQC
     */
    multiqc_args = ""
}

process {
    errorStrategy = 'retry'
    maxRetries = 1
}
