/*
 * Module-specific configuration
 */

process {

    withName: FASTQC_RAW {
        ext.args = params.fastqc_args
    }

    withName: FASTQC_CLEAN {
        ext.args = params.fastqc_args
    }

    withName: FASTP {
        ext.args = params.fastp_args
    }

    withName: SORTMERNA {
        ext.args = params.sortmerna_args
    }

    withName: STAR {
        ext.args = params.star_args
    }

    withName: SPADES_RNA {
        ext.args = params.spades_rna_args
    }

    withName: QUAST {
        ext.args = params.quast_args
    }

    withName: TRANSDECODER {
        ext.longorfs_args = params.transdecoder_longorfs_args
        ext.predict_args  = params.transdecoder_predict_args
    }

    withName: DIAMOND {
        ext.args = params.diamond_args
    }

    withName: SALMON_INDEX {
        ext.args = params.salmon_index_args
    }

    withName: SALMON_QUANT {
        ext.args = params.salmon_quant_args
    }

    withName: MULTIQC {
        ext.args = params.multiqc_args
    }
}
