/*
 * Production SLURM configuration for Hypatia
 */

conda {
    enabled = true
    createTimeout = "180 min"
}

process {

    executor = 'slurm'
    queue = 'short'


    /*
     * Defaults for helper processes
     */

    withLabel: process_low {
        cpus = 1
        memory = '2 GB'
    }

    withLabel: process_medium {
        cpus = 4
        memory = '8 GB'
    }

    withLabel: process_high {
        cpus = 8
        memory = '32 GB'
    }

    withLabel: process_very_high {
        cpus = 16
        memory = '64 GB'
    }


    /*
     * Input
     */

    withName: CHECK_SAMPLESHEET {
        cpus = 1
        memory = '2 GB'
    }


    /*
     * QC
     */

    withName: FASTQC_RAW {
        cpus = 2
        memory = '4 GB'
    }

    withName: FASTQC_CLEAN {
        cpus = 2
        memory = '4 GB'
    }

    withName: FASTP {
        cpus = 6
        memory = '4 GB'
    }


    /*
     * rRNA / human removal
     */

    withName: SORTMERNA {
        cpus = 12
        memory = '16 GB'
    }

    withName: STAR {
        cpus = 12
        memory = '48 GB'
    }


    /*
     * Assembly
     */

    withName: SPADES_RNA {
        queue = 'bigmem'

        cpus = {
            task.attempt == 1 ? 16 : 32
        }

        memory = {
            task.attempt == 1 ? 500.GB : 950.GB
        }

        time = '72h'
        maxRetries = 1
    }

    withName: QUAST {
        cpus = 6
        memory = '20 GB'
    }


    /*
     * Transcript prediction
     */

    withName: TRANSDECODER {
        queue = 'bigmem'
        cpus = 4
        memory = '500 GB'
        time = '24h'
        beforeScript = '''
set -e
if [ ! -e coassembly_transdecoder_dir ]; then
    cp -al /hpcfs/home/cursos/s.abril01/Metatranscriptomics/work/d2/c1fdcbd446d54eae9fad1aa4e3eec9/coassembly_transdecoder_dir coassembly_transdecoder_dir
fi
'''
    }

    withName: FILTER_TRANSDECODER_COMPLETE_ISOFORMS {
        cpus = 1
        memory = '64 GB'
    }


    /*
     * MAG annotation
     */

    withName: PREPARE_MAG_PROTEIN_DATABASE {
        cpus = 2
        memory = '8 GB'
    }

    withName: DIAMOND {
        cpus = 24
        memory = '40 GB'
        time = '24h'
    }

    withName: FILTER_DIAMOND_BEST_HITS {
        cpus = 2
        memory = '8 GB'
    }

    withName: CREATE_TRANSCRIPT_MAG_GTF {
        cpus = 2
        memory = '8 GB'
    }


    /*
     * Quantification
     */

    withName: SALMON_INDEX {
        cpus = 8
        memory = '32 GB'
    }

    withName: SALMON_QUANT {
        cpus = 8
        memory = '24 GB'
    }


    /*
     * Expression
     */

    withName: TXIMPORT {
        queue = 'medium'
        cpus = 2
        memory = '128 GB'
        time = '12h'
    }

    withName: DESEQ2_PD_VS_HC {
        queue = 'medium'
        cpus = 4
        memory = '64 GB'
        time = '24h'
    }

    withName: EXPRESSION_SUMMARY {
        cpus = 2
        memory = '8 GB'
        time = '4h'
    }


    /*
     * Reporting
     */

    withName: MULTIQC {
        cpus = 2
        memory = '8 GB'
    }
}
